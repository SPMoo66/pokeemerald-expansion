script EventScript_MusicUnlocked {
	message ("Additional battle music unlocked\nfor the Tuning Fork!")
	playse (SE_CONTEST_PLACE)
	waitse
	waitbuttonpress
	closemessage
}

script EventScript_TuningFork {
	msgbox ("Change music?")
	dynmultipush("Wild Battle Music", 0)
	dynmultipush("Trainer Battle Music", 1)
#	dynmultipush("Debug: Set All", 2)
	dynmultistack(0, 6, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

	if (var(VAR_RESULT) == 2)
	{
		checkifmusicunlocked (0, 1)
		checkifmusicunlocked (1, 1)
		checkifmusicunlocked (2, 1)
		checkifmusicunlocked (3, 1)
		checkifmusicunlocked (4, 1)
		checkifmusicunlocked (5, 1)
		checkifmusicunlocked (6, 1)
		checkifmusicunlocked (7, 1)
		goto (EventScript_TuningFork)
	}

	if (var(VAR_RESULT) != 127) // if B not pressed
	{
		goto (EventScript_TuningFork_ChooseType)
	}
	closemessage
	release
}


script EventScript_TuningFork_ChooseType {
	copyvar (VAR_TEMP_1, VAR_RESULT)		# VAR_TEMP_1 is now 0 for wild or 1 for trainer

	msgbox ("Choose music.")
	dynmultipush("Pokémon", 0)
	dynmultipush("Other", 1)
	if ((var(VAR_TUNING_FORK_WILD) && var(VAR_TEMP_1) == 0) || (var(VAR_TUNING_FORK_TRAINER) && var(VAR_TEMP_1) == 1))
	{
		dynmultipush("Reset music", 2)
	}
	dynmultistack(0, 6, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

	if (var(VAR_RESULT) == 127) // pressed B
	{
		goto (EventScript_TuningFork) // reset to beginning
	}

	elif (var(VAR_RESULT) == 0) // Pokemon
	{
		goto (EventScript_TuningFork_Pokemon)
	}

	elif (var(VAR_RESULT) == 1) // Other
	{
		goto (EventScript_TuningFork_Other)
	}

	elif (var(VAR_RESULT) == 2) // Reset music to vanilla
	{
		if (var(VAR_TEMP_1) == 0)
		{
			setvar (VAR_TUNING_FORK_WILD, 0)
		}
		else
		{
			setvar(VAR_TUNING_FORK_TRAINER, 0)
		}
		msgbox ("Music reset!")
		goto (EventScript_TuningFork) // reset to beginning
	}
	release
}


script EventScript_TuningFork_Pokemon {
	msgbox ("Choose game.")
	dynmultipush("RSE", 0)
	dynmultipush("FRLG", 1)
	dynmultipush("DPPt", 2)
	dynmultipush("HGSS", 3)
	checkifmusicunlocked (3) // this checks if the player unlocked BW music (Wild/Trainer from Exp 1)
	if (var(VAR_RESULT))
	{
		dynmultipush("BW", 4)
	}
	checkifmusicunlocked (6) // this checks if the player unlocked XD Vs Cipher (the first other song, from Exp 1)
	if (var(VAR_RESULT))
	{
		dynmultipush("Other", 5)
	}
	dynmultistack(0, 2, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

	if (var(VAR_RESULT) == 0) // RSE
	{
		goto (EventScript_TuningFork_PokemonRSE)
	}

	elif (var(VAR_RESULT) == 1) // FRLG
	{
		goto (EventScript_TuningFork_PokemonFRLG)
	}

	elif (var(VAR_RESULT) == 2) // DPPt
	{
		goto (EventScript_TuningFork_PokemonDPPt)
	}

	elif (var(VAR_RESULT) == 3) // HGSS
	{
		goto (EventScript_TuningFork_PokemonHGSS)
	}

	elif (var(VAR_RESULT) == 4) // BW
	{
		goto (EventScript_TuningFork_PokemonBW)
	}

	elif (var(VAR_RESULT) == 5) // Other
	{
		goto (EventScript_TuningFork_PokemonOther)
	}

	else // pressed B
	{
		goto (EventScript_TuningFork_ChooseType)
	}
}

script EventScript_TuningFork_PokemonRSE {
	msgbox (TextChooseSong)
	dynmultipush ("RSE Vs. Rival", 0)
	dynmultipush ("RSE Vs. Gym Leader", 1)
	dynmultipush ("RSE Vs. Aqua/Magma", 2)
	checkifmusicunlocked (0)
	if (var(VAR_RESULT))
	{
		dynmultipush ("RSE Vs. Aqua/Magma Leader", 3)
	}
	checkifmusicunlocked (1)
	if (var(VAR_RESULT))
	{
		dynmultipush ("RSE Vs. Elite Four", 4)
		dynmultipush ("RSE Vs. Champion", 5)
		dynmultipush ("RSE Vs. Frontier Brain", 6)
	}
	checkifmusicunlocked (2)
	if (var(VAR_RESULT))
	{
		dynmultipush ("RSE Vs. Kyogre/Groudon", 7)
		dynmultipush ("RSE Vs. Regi", 8)
		dynmultipush ("RSE Vs. Rayquaza", 9)
		dynmultipush ("RSE Vs. Mew", 10)
	}
	dynmultistack(0, 2, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
	switch (var(VAR_RESULT))
	{
	case 0:
		setvar (VAR_TEMP_2, 1)
		goto (EventScript_TuningFork_SetMusic)
	case 1:
		setvar (VAR_TEMP_2, 2)
		goto (EventScript_TuningFork_SetMusic)
	case 2:
		setvar (VAR_TEMP_2, 3)
		goto (EventScript_TuningFork_SetMusic)
	case 3:
		setvar (VAR_TEMP_2, 4)
		goto (EventScript_TuningFork_SetMusic)
	case 4:
		setvar (VAR_TEMP_2, 5)
		goto (EventScript_TuningFork_SetMusic)
	case 5:
		setvar (VAR_TEMP_2, 6)
		goto (EventScript_TuningFork_SetMusic)
	case 6:
		setvar (VAR_TEMP_2, 7)
		goto (EventScript_TuningFork_SetMusic)
	case 7:
		setvar (VAR_TEMP_2, 8)
		goto (EventScript_TuningFork_SetMusic)
	case 8:
		setvar (VAR_TEMP_2, 9)
		goto (EventScript_TuningFork_SetMusic)
	case 9:
		setvar (VAR_TEMP_2, 10)
		goto (EventScript_TuningFork_SetMusic)
	case 10:
		setvar (VAR_TEMP_2, 11)
		goto (EventScript_TuningFork_SetMusic)
	default: // pressed B
		goto (EventScript_TuningFork_Pokemon)
	}
}

