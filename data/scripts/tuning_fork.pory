script EventScript_TuningFork_Other {
	msgbox (TextChooseSong)
	dynmultipush ("FF4: Battle 2", 0)
	checkifmusicunlocked (7) // checks for the below song
	if (var(VAR_RESULT))
	{
		dynmultipush ("KH1: Disappeared", 1)
	}

	dynmultistack(0, 2, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

	switch (var(VAR_RESULT))
	{
	case 0:
		setvar (VAR_TEMP_2, 45)
		goto (EventScript_TuningFork_SetMusic)
	case 1:
		setvar (VAR_TEMP_2, 48)
		goto (EventScript_TuningFork_SetMusic)
	default: // pressed B
		goto (EventScript_TuningFork_ChooseType)
	}
}

script EventScript_TuningFork_SetMusic {
	if (!var(VAR_TEMP_1))
	{
		copyvar (VAR_TUNING_FORK_WILD, VAR_TEMP_2)
	}
	else
	{
		copyvar (VAR_TUNING_FORK_TRAINER, VAR_TEMP_2)
	}
	msgbox ("Music set!")
	closemessage
	release
}

text TextChooseSong {
	"Choose song."
}

